# Copy to .env and fill in real secrets before running `docker compose up`.

# Postgres
POSTGRES_DB=geoguessr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host ports — change these if 3000/8080 are already taken on the deploy host.
# Container-internal ports stay 8080 (backend) and 3000 (web), only the
# host-side mapping changes, so update the *_URL vars below to match.
BACKEND_PORT=8080
WEB_PORT=3000

# Backend
JWT_SECRET=change-this-to-a-long-random-string

# Web — build-time (baked into the Next.js bundle, changing these requires a rebuild)
NEXT_PUBLIC_API_URL=http://backend:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_MAPS_KEY=your-google-maps-api-key

# Web — runtime
NEXTAUTH_SECRET=change-this-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
