# Copy to .env and fill in real secrets before running `docker compose up`.
#
# backend and web are pulled as prebuilt images from GHCR (built and pushed by
# .github/workflows/deploy.yml) rather than built locally — see IMAGE_NAME below.
# NEXT_PUBLIC_* vars are baked into the web image at CI build time, so they live
# as variables/secrets on the "prd" GitHub environment, not in this file.

# Postgres
POSTGRES_DB=geo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host ports — change these if 3000/8080/5432 are already taken on the deploy host.
BACKEND_PORT=8080
WEB_PORT=3000
POSTGRES_PORT=5432

# Backend
JWT_SECRET=change-this-to-a-long-random-string

# Admin account, auto-created on first startup with the ADMIN role (skipped if the
# user already exists, so changing the password here later has no effect).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# GHCR image namespace, e.g. peterriek/geo — must match the
# IMAGE_NAME variable set on the "prd" GitHub environment used by the workflow.
# Images are pulled as ghcr.io/<IMAGE_NAME>-backend and ghcr.io/<IMAGE_NAME>-web.
IMAGE_NAME=peterriek/geo

# Web — runtime
NEXTAUTH_SECRET=change-this-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
